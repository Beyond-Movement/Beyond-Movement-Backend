# Copy to .env and fill in. .env is gitignored; this template is committed.
POSTGRES_USER=mc
POSTGRES_PASSWORD=change_me
POSTGRES_DB=mentalcoaching

# Host port Postgres is published on. Use 5432 unless something already owns it.
POSTGRES_HOST_PORT=5432

PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change_me
