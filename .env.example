# ============================================================================
#  Beyond Movement - Backend environment reference
# ============================================================================
#  Copy to .env and fill in. .env is gitignored; this template is committed.
#
#  Two audiences, two halves of this file:
#
#   PART A  docker-compose (local dev only). Substituted into docker-compose.yml
#           by the `docker compose` CLI, which reads ./.env automatically.
#
#   PART B  the API process itself. ASP.NET Core reads these as environment
#           variables and overlays them on appsettings.json.
#
#  ---- The one rule that trips people up ------------------------------------
#  Nested config keys use a DOUBLE UNDERSCORE, never a colon and never a single
#  underscore. The JSON key "Jwt": { "SigningKey": ... } is the environment
#  variable Jwt__SigningKey. Get this wrong and the app does not error - it
#  silently keeps the appsettings.json default, or fails at startup saying the
#  key is missing.
#
#  Env vars beat appsettings.json, appsettings.{Environment}.json and user
#  secrets. Anything not set here falls back to the committed appsettings.json,
#  so a variable left blank below is not "unset" - it is "whatever the repo
#  shipped". Blank values that must be filled are marked REQUIRED.
# ============================================================================


# ============================================================================
#  PART A - docker-compose (local development only)
# ============================================================================
#  Consumed by docker-compose.yml. If the API is deployed to a managed host with
#  a managed Postgres, PART A is irrelevant - skip to PART B.

POSTGRES_USER=mc
POSTGRES_PASSWORD=change_me
POSTGRES_DB=mentalcoaching

# Host port Postgres is published on. Use 5432 unless a locally installed
# PostgreSQL service already owns it (common on Windows dev machines).
POSTGRES_HOST_PORT=5432

# pgAdmin web UI at http://localhost:5050. Developer convenience only - the API
# never talks to it. Do not run this container in a deployed environment.
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change_me

# The other compose services take no variables:
#   mailpit  local mail catcher. SMTP on 1025, web inbox on http://localhost:8025.
#            Everything the API sends lands there and reaches nobody real.
#   redis    started by compose but NOT used by any code yet. Reserved for a
#            Phase 9 cache in front of the account-status lookup. Nothing breaks
#            if it is absent today.


# ============================================================================
#  PART B - the API process
# ============================================================================

# ---------------------------------------------------------------------------
#  Hosting
# ---------------------------------------------------------------------------
# Development | Staging | Production. Not cosmetic - it changes behaviour:
#   Development    serves the OpenAPI document at /openapi/v1.json and the
#                  Scalar UI at /scalar/v1 anonymously, APPLIES EF MIGRATIONS ON
#                  STARTUP, and seeds an admin user from Seed__* below.
#   anything else  none of that. No docs endpoint, no self-migration, no
#                  seeding. Migrations become a deliberate deploy step. This is
#                  intentional: an app that migrates itself can rewrite a
#                  database nobody meant to touch.
ASPNETCORE_ENVIRONMENT=Production

# Where Kestrel listens inside the container. Terminate TLS at the load balancer
# and let the container speak plain HTTP on one port unless there is a reason not to.
ASPNETCORE_URLS=http://+:8080

# ---------------------------------------------------------------------------
#  Database - REQUIRED
# ---------------------------------------------------------------------------
# Npgsql keyword=value format, NOT a postgres:// URL. Npgsql will not parse a
# URL; if the provider hands you one, convert it.
# Managed Postgres almost always needs SSL Mode=Require.
ConnectionStrings__Postgres=Host=db.example.com;Port=5432;Database=mentalcoaching;Username=mc;Password=change_me;SSL Mode=Require;Trust Server Certificate=true

# The API needs SELECT/INSERT/UPDATE/DELETE at run time. It does NOT need DDL
# rights at run time - migrations run as a separate step and can use a separate,
# higher-privileged role.

# ---------------------------------------------------------------------------
#  JWT - REQUIRED
# ---------------------------------------------------------------------------
# Signing key for access tokens, refresh tokens and the short-lived registration
# token. Validated at startup: the app refuses to boot if this is missing or
# under 32 bytes (HMAC-SHA256 fails with IDX10720 below that). Use 64+ chars.
#
#   openssl rand -base64 64 | tr -d '\n'
#
# A real secret: secret manager / key vault, never a file, never source control.
# Rotating it invalidates every issued token - every user is logged out.
Jwt__SigningKey=

# These have working defaults in appsettings.json. Override only deliberately -
# issuer and audience are validated on every request, so changing either without
# changing it everywhere rejects all existing tokens.
Jwt__Issuer=beyond-movement
Jwt__Audience=beyond-movement-app
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=30

# ---------------------------------------------------------------------------
#  Email
# ---------------------------------------------------------------------------
# Transport is chosen at startup, first match wins, and the choice is printed to
# the console so it can be confirmed in the logs:
#
#   1. Postmark   if Email__Postmark__ServerToken AND Email__FromAddress are set
#   2. SMTP       if Email__Smtp__Host           AND Email__FromAddress are set
#   3. console    otherwise - invitation codes and reset links are PRINTED TO
#                 STDOUT and sent to nobody. Fine for a fresh clone, never for a
#                 deployed environment: invitation codes sitting in a log
#                 aggregator are a credential leak.
#
# Deployed environments should use Postmark.

# The from-address. Must be on a domain verified in Postmark with SPF and DKIM
# published, or mail is rejected outright - and when it is accepted anyway it
# lands in spam, which for an invitation means the athlete never joins.
Email__FromAddress=no-reply@beyondmovement.com

# Display name recipients see. LEAVE EMPTY when sending from a free provider
# (Gmail and friends): a brand name over an @gmail.com address is the shape of
# phishing and Gmail files it as spam - measured, not guessed. Set it once mail
# is sent from a domain with DKIM, where it helps.
Email__FromName=

# Where replies go. Defaults to the from-address. Worth pointing at a monitored
# mailbox: mail that accepts no reply scores worse with spam filters.
Email__ReplyToAddress=

# --- Postmark (the deployed transport) ---
# Server API token - a SECRET, treat it like a password.
# Postmark dashboard -> your server -> API Tokens.
Email__Postmark__ServerToken=

# Postmark separates transactional from bulk. Invitations and password resets
# are transactional; sending them on a broadcast stream harms deliverability for
# both.
Email__Postmark__MessageStream=outbound

# --- SMTP (local catcher, or a fallback where there is no Postmark account) ---
# Leave Host empty in any environment using Postmark. Host=localhost, 127.0.0.1
# or mailpit is recognised as a catcher and logged as "nothing leaves this
# machine"; any other host is logged as REAL mail to real inboxes.
Email__Smtp__Host=
Email__Smtp__Port=1025
Email__Smtp__UseSsl=false
Email__Smtp__Username=
Email__Smtp__Password=

# --- Branding inside the emails ---
# Absolute HTTPS URL of the logo, publicly reachable. Mail clients fetch it when
# the message is opened and Gmail proxies it, so a localhost address resolves to
# nothing on the recipient device and a data: URI is stripped. Empty falls back
# to a typeset wordmark, which is a fine answer.
# The file is served from the API wwwroot: <public-base-url>/brand/logo.png
Email__LogoUrl=

# A REAL postal address for the footer, or empty. Leave empty until the business
# has one - an invented address in a footer is a false statement about a real
# organisation.
Email__PostalAddress=

# ---------------------------------------------------------------------------
#  App
# ---------------------------------------------------------------------------
# The link put in a password-reset email. {token} is substituted; keep the
# placeholder exactly. Currently a deep link into the mobile app - change only
# in step with the client team, since a wrong scheme means an unopenable link.
App__PasswordResetUrlTemplate=beyondmovement://reset-password?token={token}

# Returned by the app-status endpoint. The client compares its own version and
# forces an upgrade below this. Raising it locks out old installs - a product
# decision, not a deploy-time one.
App__MinimumSupportedAppVersion=1.0.0

# ---------------------------------------------------------------------------
#  Google Sign-In
# ---------------------------------------------------------------------------
# Client IDs are PUBLIC by design - they are an audience the API checks a Google
# token against, not a secret. Real values already ship in appsettings.json; set
# these only to point an environment at a different Google project. Any left
# blank here fall back to the committed values; any blank there are skipped, so
# blanking all three disables Google sign-in.
Google__ClientId__Web=
Google__ClientId__Android=
Google__ClientId__iOS=

# ---------------------------------------------------------------------------
#  Rate limiting
# ---------------------------------------------------------------------------
# Invitation-code validation attempts per hour per IP. Default 10. That endpoint
# is a guessing oracle without a limit - raise it only with a reason.
# NOTE: the limiter partitions on the socket remote IP. Behind a proxy or load
# balancer that is the PROXY IP, so every client shares one bucket. If one is
# put in front, forwarded-headers handling has to be added in code first - raise
# it with the backend team rather than raising this number.
RateLimits__InvitationValidationPerHour=10

# ---------------------------------------------------------------------------
#  Admin seeding - DEVELOPMENT ONLY
# ---------------------------------------------------------------------------
# Runs only when ASPNETCORE_ENVIRONMENT=Development, and only when no admin
# exists yet. There is no public registration for admins, so a deployed
# environment gets its first admin by a deliberate, manual insert - not by
# setting these. Leave unset outside development.
Seed__AdminEmail=admin@beyondmovement.com
Seed__AdminFullName=Beyond Movement Admin
Seed__AdminPassword=

# ---------------------------------------------------------------------------
#  Logging
# ---------------------------------------------------------------------------
# Serilog writes to the console; collect stdout.
# Verbose | Debug | Information | Warning | Error | Fatal
Serilog__MinimumLevel__Default=Information
Serilog__MinimumLevel__Override__Microsoft.AspNetCore=Warning

# Logs every executed SQL statement. Useful when chasing a query; noisy, and a
# PII risk through parameter values, if left on. Keep at Warning outside debugging.
Serilog__MinimumLevel__Override__Microsoft.EntityFrameworkCore.Database.Command=Warning
