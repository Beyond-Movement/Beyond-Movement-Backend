{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information"
      }
    }
  },

  // Development defaults. Mail goes to the Mailpit container from docker-compose, where it can
  // be opened and clicked at http://localhost:8025 and can never reach a real person. None of
  // this is secret, which is why it lives here rather than in user secrets.
  "Email": {
    "FromAddress": "no-reply@beyondmovement.local",
    // Empty on purpose. A brand display name over a free-provider address is a phishing
    // shape and Gmail files it as spam - measured, not guessed. Set it only when sending
    // from a domain with DKIM.
    "FromName": "",
    "LogoUrl": "http://localhost:5229/brand/logo.png",
    "Smtp": {
      "Host": "localhost",
      "Port": 1025,
      "UseSsl": false
    }
  }
}
