{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "beyond-movement",
    "Audience": "beyond-movement-app",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "Seed": {
    "AdminEmail": "admin@beyondmovement.com",
    "AdminFullName": "Beyond Movement Admin"
  },
  "App": {
    "PasswordResetUrlTemplate": "https://app.beyondmovement.com/reset-password?token={token}"
  }
}
